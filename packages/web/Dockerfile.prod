# ==========================================
# STAGE 1: deps (Instalar dependencias aisladas)
# ==========================================
FROM node:22-alpine AS deps
WORKDIR /app

# Copiamos manifiestos de la raíz y SOLO de los workspaces que el frontend usa
COPY package*.json ./
COPY packages/web/package.json packages/web/
COPY packages/shared/package.json packages/shared/

# Instalación aislada: le decimos a npm que solo instale las dependencias de web y shared
RUN npm ci --workspace=packages/web --include-workspace-root

# ==========================================
# STAGE 2: build (Compilar el frontend)
# ==========================================
FROM node:22-alpine AS build
WORKDIR /app

# Traemos los node_modules optimizados de la etapa anterior
COPY --from=deps /app/node_modules ./node_modules

# Copiamos el código fuente (tu .dockerignore ya excluye lo que no sirve)
COPY . .

# Ejecutamos Vite build para empaquetar el frontend
RUN npm run build -w packages/web

# ==========================================
# STAGE 3: runtime (Servidor web Nginx)
# ==========================================
FROM nginx:1.24-alpine AS runtime


# Configuramos Nginx
COPY packages/web/nginx.conf /etc/nginx/conf.d/default.conf

# Copiamos los archivos estáticos desde la etapa de 'build'
COPY --from=build /app/packages/web/dist /usr/share/nginx/html

EXPOSE 80

# Healthcheck HTTP requerido
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1/ || exit 1

# Arrancamos Nginx
CMD ["nginx", "-g", "daemon off;"]