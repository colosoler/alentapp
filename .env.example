# Plantilla de variables de entorno para docker-compose.prod.yml
# Copiar a ".env" y reemplazar los valores. El archivo .env NO debe versionarse.
#
#   cp .env.example .env

# --- PostgreSQL ---
POSTGRES_USER=alentapp
POSTGRES_PASSWORD=cambiar_por_un_password_seguro
POSTGRES_DB=alentapp_db

# --- API ---
# El host debe ser "db" (nombre del servicio en la red interna del compose).
DATABASE_URL=postgres://alentapp:cambiar_por_un_password_seguro@db:5432/alentapp_db
